# Copy to .env (git-ignored) and replace every value marked CHANGE_ME.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

MLP_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_value
POSTGRES_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=mlp-admin
S3_SECRET_KEY=CHANGE_ME
# Shared by the worker (deploy step) and the model server's /admin/reload
MLP_SERVING_ADMIN_TOKEN=CHANGE_ME

# Local HTTP: the refresh cookie must not require HTTPS
MLP_COOKIE_SECURE=false
MLP_CORS_ORIGINS=["http://localhost:8088","http://localhost:5173"]

# manual = an approver promotes each candidate; auto = candidates that pass every gate deploy themselves
MLP_APPROVAL_POLICY=manual
MLP_DEPLOY_TARGET=local
# Password for the demo users created by `python -m app.cli demo` (12+ characters)
MLP_DEMO_PASSWORD=CHANGE_ME_demo_password
